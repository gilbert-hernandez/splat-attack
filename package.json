{
  "name": "splat-attack",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "description": "Splat Attack: a score-chasing falling-pair versus puzzle game (Phaser 4 + Vite).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "record": "node scripts/record.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "replays": "node scripts/replays.js",
    "release:check": "node scripts/release-check.js",
    "release:archive": "node scripts/release-archive.js",
    "sim": "node scripts/sim.js"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
